{
	"info": {
		"_postman_id": "mediqueue-e2e-collection",
		"name": "MediQueue — Flujo E2E Completo",
		"description": "Colección para demostrar el flujo completo de la plataforma MediQueue.\n\nOrden de ejecución:\n1. Crear paciente\n2. Crear dentista\n3. Crear slot de cita\n4. Crear cita (con idempotencia)\n5. Consultar pago generado\n6. Consultar cita confirmada\n7. Consultar notificaciones del paciente\n\n**Prerequisitos:** Levantar todos los servicios con `docker compose up -d` y esperar ~60s para que los health checks estén verdes.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "patientId",
			"value": "",
			"type": "string"
		},
		{
			"key": "patientEmail",
			"value": "",
			"type": "string"
		},
		{
			"key": "dentistId",
			"value": "",
			"type": "string"
		},
		{
			"key": "slotId",
			"value": "",
			"type": "string"
		},
		{
			"key": "slotDate",
			"value": "",
			"type": "string"
		},
		{
			"key": "slotStartTime",
			"value": "",
			"type": "string"
		},
		{
			"key": "slotEndTime",
			"value": "",
			"type": "string"
		},
		{
			"key": "appointmentId",
			"value": "",
			"type": "string"
		},
		{
			"key": "idempotencyKey",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "0. Health Check — API Gateway",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/actuator/health",
					"host": ["{{baseUrl}}"],
					"path": ["actuator", "health"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('API Gateway is healthy', function () {",
							"    pm.response.to.have.status(200);",
							"    const body = pm.response.json();",
							"    pm.expect(body.status).to.eql('UP');",
							"});",
							""
						]
					}
				}
			],
			"response": []
		},
		{
			"name": "1. Crear Paciente",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"firstName\": \"María\",\n    \"lastName\": \"González Pérez\",\n    \"email\": \"maria.gonzalez.{{$timestamp}}@mediqueue.test\",\n    \"phone\": \"+50688887777\",\n    \"documentNumber\": \"DOC-{{$timestamp}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/patients",
					"host": ["{{baseUrl}}"],
					"path": ["api", "patients"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Patient created successfully', function () {",
							"    pm.response.to.have.status(201);",
							"    const body = pm.response.json();",
							"    pm.expect(body.id).to.not.be.undefined;",
							"    pm.collectionVariables.set('patientId', body.id);",
							"    pm.collectionVariables.set('patientEmail', body.email);",
							"    console.log('✅ Patient ID saved: ' + body.id);",
							"});",
							""
						]
					}
				}
			],
			"response": []
		},
		{
			"name": "2. Crear Dentista",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"firstName\": \"Carlos\",\n    \"lastName\": \"Ramírez López\",\n    \"specialty\": \"Ortodoncia\",\n    \"email\": \"dr.ramirez.{{$timestamp}}@mediqueue.test\",\n    \"licenseNumber\": \"LIC-{{$timestamp}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/dentists",
					"host": ["{{baseUrl}}"],
					"path": ["api", "dentists"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Dentist created successfully', function () {",
							"    pm.response.to.have.status(201);",
							"    const body = pm.response.json();",
							"    pm.expect(body.id).to.not.be.undefined;",
							"    pm.collectionVariables.set('dentistId', body.id);",
							"    console.log('✅ Dentist ID saved: ' + body.id);",
							"});",
							""
						]
					}
				}
			],
			"response": []
		},
		{
			"name": "3. Crear Slot de Cita",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"dentistId\": \"{{dentistId}}\",\n    \"slotDate\": \"2026-06-15\",\n    \"startTime\": \"09:00\",\n    \"endTime\": \"09:30\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/slots",
					"host": ["{{baseUrl}}"],
					"path": ["api", "slots"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Slot created successfully', function () {",
							"    pm.response.to.have.status(201);",
							"    const body = pm.response.json();",
							"    pm.expect(body.id).to.not.be.undefined;",
							"    pm.collectionVariables.set('slotId', body.id);",
							"    pm.collectionVariables.set('slotDate', body.slotDate || '2026-06-15');",
							"    pm.collectionVariables.set('slotStartTime', body.startTime || '09:00');",
							"    pm.collectionVariables.set('slotEndTime', body.endTime || '09:30');",
							"    console.log('✅ Slot ID saved: ' + body.id);",
							"});",
							""
						]
					}
				}
			],
			"response": []
		},
		{
			"name": "4. Crear Cita (con Idempotencia)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "X-Idempotency-Key",
						"value": "{{idempotencyKey}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"patientId\": \"{{patientId}}\",\n    \"dentistId\": \"{{dentistId}}\",\n    \"slotId\": \"{{slotId}}\",\n    \"appointmentDate\": \"{{slotDate}}\",\n    \"startTime\": \"{{slotStartTime}}\",\n    \"endTime\": \"{{slotEndTime}}\",\n    \"notes\": \"Consulta de revisión general — demo checkpoint 1\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/appointments",
					"host": ["{{baseUrl}}"],
					"path": ["api", "appointments"]
				}
			},
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// Generate a unique idempotency key for this request",
							"const key = 'demo-' + Date.now() + '-' + Math.random().toString(36).substring(2, 8);",
							"pm.collectionVariables.set('idempotencyKey', key);",
							"console.log('🔑 Idempotency Key: ' + key);",
							""
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Appointment created successfully', function () {",
							"    pm.response.to.have.status(201);",
							"    const body = pm.response.json();",
							"    pm.expect(body.id).to.not.be.undefined;",
							"    pm.collectionVariables.set('appointmentId', body.id);",
							"    console.log('✅ Appointment ID saved: ' + body.id);",
							"    console.log('📋 Status: ' + body.status);",
							"});",
							""
						]
					}
				}
			],
			"response": []
		},
		{
			"name": "5. Consultar Pago (por appointmentId)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/payments?appointmentId={{appointmentId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "payments"],
					"query": [
						{
							"key": "appointmentId",
							"value": "{{appointmentId}}"
						}
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Payment query returns 200', function () {",
							"    pm.response.to.have.status(200);",
							"    const body = pm.response.json();",
							"    console.log('💳 Payment response: ' + JSON.stringify(body, null, 2));",
							"});",
							""
						]
					}
				}
			],
			"response": []
		},
		{
			"name": "6. Consultar Cita (estado actualizado)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/appointments/{{appointmentId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "appointments", "{{appointmentId}}"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Appointment retrieved successfully', function () {",
							"    pm.response.to.have.status(200);",
							"    const body = pm.response.json();",
							"    pm.expect(body.id).to.eql(pm.collectionVariables.get('appointmentId'));",
							"    console.log('📋 Appointment status: ' + body.status);",
							"});",
							""
						]
					}
				}
			],
			"response": []
		},
		{
			"name": "7. Consultar Notificaciones del Paciente",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/notifications/patient/{{patientId}}",
					"host": ["{{baseUrl}}"],
					"path": ["api", "notifications", "patient", "{{patientId}}"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Notifications retrieved for patient', function () {",
							"    pm.response.to.have.status(200);",
							"    const body = pm.response.json();",
							"    console.log('🔔 Notifications: ' + JSON.stringify(body, null, 2));",
							"});",
							""
						]
					}
				}
			],
			"response": []
		},
		{
			"name": "8. Test Idempotencia — Retry misma cita",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "X-Idempotency-Key",
						"value": "{{idempotencyKey}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"patientId\": \"{{patientId}}\",\n    \"dentistId\": \"{{dentistId}}\",\n    \"slotId\": \"{{slotId}}\",\n    \"appointmentDate\": \"{{slotDate}}\",\n    \"startTime\": \"{{slotStartTime}}\",\n    \"endTime\": \"{{slotEndTime}}\",\n    \"notes\": \"Retry — debe retornar la misma cita sin duplicar\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/appointments",
					"host": ["{{baseUrl}}"],
					"path": ["api", "appointments"]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Idempotency works — same appointment returned or 409', function () {",
							"    const status = pm.response.code;",
							"    pm.expect(status).to.be.oneOf([200, 201, 409]);",
							"    if (status === 200 || status === 201) {",
							"        const body = pm.response.json();",
							"        pm.expect(body.id).to.eql(pm.collectionVariables.get('appointmentId'));",
							"        console.log('✅ Idempotency verified — same appointment ID returned');",
							"    } else {",
							"        console.log('✅ Idempotency verified — 409 Conflict (already processed)');",
							"    }",
							"});",
							""
						]
					}
				}
			],
			"response": []
		}
	]
}
