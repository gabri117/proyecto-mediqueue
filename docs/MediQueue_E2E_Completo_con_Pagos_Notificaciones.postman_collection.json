          "raw": "{\n    \"firstName\": \"María\",\n    \"lastName\": \"González Pérez\",\n    \"email\": \"maria.gonzalez.{{$timestamp}}@mediqueue.test\",\n    \"phone\": \"+50688887777\",\n    \"documentNumber\": \"DOC-{{$timestamp}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/patients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "patients"
