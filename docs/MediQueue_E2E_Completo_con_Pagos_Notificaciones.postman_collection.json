    {
      "name": "4. Crear Cita (con Idempotencia)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"patientId\": \"{{patientId}}\",\n    \"dentistId\": \"{{dentistId}}\",\n    \"slotId\": \"{{slotId}}\",\n    \"appointmentDate\": \"{{slotDate}}\",\n    \"startTime\": \"{{slotStartTime}}\",\n    \"endTime\": \"{{slotEndTime}}\",\n    \"notes\": \"Consulta de revisión general — demo checkpoint 1\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/appointments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "appointments"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Generate a unique idempotency key for this request",
              "const key = 'demo-' + Date.now() + '-' + Math.random().toString(36).substring(2, 8);",
              "pm.collectionVariables.set('idempotencyKey', key);",
              "console.log('🔑 Idempotency Key: ' + key);",
              ""
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Appointment created successfully', function () {",
              "    pm.response.to.have.status(201);",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.not.be.undefined;",
              "    pm.collectionVariables.set('appointmentId', body.id);",
              "    console.log('✅ Appointment ID saved: ' + body.id);",
              "    console.log('📋 Status: ' + body.status);",
              "});",
              ""
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "5. Consultar Pago (por appointmentId)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/payments?appointmentId={{appointmentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payments"
          ],
          "query": [
            {
              "key": "appointmentId",
              "value": "{{appointmentId}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Payment query returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    console.log('💳 Payment response: ' + JSON.stringify(body, null, 2));",
              "});",
              ""
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "5A. POST Pago Manual — payment-service",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Idempotency-Key",
            "value": "{{paymentIdempotencyKey}}"
          },
          {
            "key": "X-Client-Id",
            "value": "postman-payment-client"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"appointmentId\": \"{{appointmentId}}\",\n    \"patientId\": \"{{patientId}}\",\n    \"amount\": 150.00,\n    \"currency\": \"GTQ\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payments"
          ]
        },
        "description": "Crea un pago manual pasando por el API Gateway. Requiere X-Idempotency-Key. Útil para probar payment-service sin depender de la saga completa. Si appointmentId ya fue pagado, puede devolver 409 o REJECTED según la implementación."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const key = 'manual-payment-' + Date.now() + '-' + Math.random().toString(36).substring(2, 8);",
              "pm.collectionVariables.set('paymentIdempotencyKey', key);",
              "console.log('🔑 Payment Idempotency Key: ' + key);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Manual payment returns controlled status', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 202, 409]);",
              "});",
              "if ([200,201,202].includes(pm.response.code)) {",
              "    const body = pm.response.json();",
              "    if (body.paymentId) { pm.collectionVariables.set('paymentId', body.paymentId); }",
              "    console.log('💳 Manual payment response: ' + JSON.stringify(body, null, 2));",
              "} else {",
              "    console.log('⚠️ Payment conflict or controlled rejection: ' + pm.response.text());",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
