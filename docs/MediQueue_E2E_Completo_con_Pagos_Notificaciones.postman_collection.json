    {
      "name": "8. Test Idempotencia — Retry misma cita",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"patientId\": \"{{patientId}}\",\n    \"dentistId\": \"{{dentistId}}\",\n    \"slotId\": \"{{slotId}}\",\n    \"appointmentDate\": \"{{slotDate}}\",\n    \"startTime\": \"{{slotStartTime}}\",\n    \"endTime\": \"{{slotEndTime}}\",\n    \"notes\": \"Retry — debe retornar la misma cita sin duplicar\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/appointments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "appointments"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Idempotency works — same appointment returned or 409', function () {",
              "    const status = pm.response.code;",
              "    pm.expect(status).to.be.oneOf([200, 201, 409]);",
              "    if (status === 200 || status === 201) {",
              "        const body = pm.response.json();",
              "        pm.expect(body.id).to.eql(pm.collectionVariables.get('appointmentId'));",
              "        console.log('✅ Idempotency verified — same appointment ID returned');",
              "    } else {",
              "        console.log('✅ Idempotency verified — 409 Conflict (already processed)');",
              "    }",
              "});",
              ""
            ]
          }
        }
      ],
      "response": []
    }
