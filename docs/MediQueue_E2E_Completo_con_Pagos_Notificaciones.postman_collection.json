    {
      "name": "8A. POST Notificación Manual — notification-service (si está habilitado)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Client-Id",
            "value": "postman-notification-client"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"patientId\": \"{{patientId}}\",\n    \"appointmentId\": \"{{appointmentId}}\",\n    \"eventType\": \"MANUAL_TEST\",\n    \"channel\": \"EMAIL\",\n    \"destination\": \"{{patientEmail}}\",\n    \"message\": \"Notificación manual de prueba desde Postman\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/notifications",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notifications"
          ]
        },
        "description": "POST manual para notification-service. En la documentación original notification-service es principalmente consumidor de eventos y expone GET /notifications?patientId={id}; por eso este POST solo funcionará si el equipo implementó un endpoint manual de prueba. Si devuelve 404, usar la saga o RabbitMQ para generar notificaciones."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Manual notification endpoint returns controlled status', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 202, 404]);",
              "});",
              "if ([200,201,202].includes(pm.response.code)) {",
              "    const body = pm.response.json();",
              "    if (body.id || body.notificationId) { pm.collectionVariables.set('notificationId', body.id || body.notificationId); }",
              "    console.log('🔔 Manual notification response: ' + JSON.stringify(body, null, 2));",
              "} else {",
              "    console.log('⚠️ POST /api/notifications no está habilitado en este servicio. Respuesta: ' + pm.response.text());",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
