# =============================================================================
# mediqueue-appointment-service — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your local environment.
# NEVER commit .env to the repository.
# =============================================================================

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5435/mediqueue_appointment
DB_USER=
DB_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASS=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Appointment Hold Configuration
APPOINTMENT_HOLD_TTL_MINUTES=5
HOLD_EXPIRATION_SCAN_SECONDS=30
OUTBOX_PUBLISH_INTERVAL_SECONDS=1
OUTBOX_RETRY_INTERVAL_SECONDS=30
IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS=3600
OUTBOX_CLEANUP_INTERVAL_SECONDS=86400
