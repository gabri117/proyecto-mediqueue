{
  "__inputs": [],
  "__elements": {},
  "__requires": [
    { "type": "grafana",    "id": "grafana",    "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries",  "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat",        "name": "Stat",        "version": "" },
    { "type": "panel", "id": "gauge",       "name": "Gauge",       "version": "" },
    { "type": "panel", "id": "bargauge",    "name": "Bar gauge",   "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Acuerdo de Nivel de Servicio (SLA): disponibilidad por servicio, uptime, presupuesto de errores y confiabilidad del sistema en distintos horizontes de tiempo",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 500,
      "title": "Disponibilidad de Servicios — ¿Cuánto tiempo estuvo operativo cada servicio?",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Porcentaje del tiempo que el API Gateway estuvo activo y respondiendo en las últimas 24 horas. El estándar de la industria (SLA 99.9%) permite solo 1.44 minutos de inactividad al día.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "min": 90, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 99 }, { "color": "green", "value": 99.9 }
          ]},
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "id": 501,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name", "colorMode": "background", "graphMode": "none" },
      "targets": [{ "expr": "avg_over_time(up{job=\"api-gateway\"}[24h]) * 100", "legendFormat": "Uptime %", "refId": "A" }],
      "title": "API Gateway — Disponibilidad 24h",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Porcentaje de disponibilidad del Servicio de Pacientes en las últimas 24 horas. Si cae, los pacientes no pueden acceder a sus datos médicos.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "min": 90, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 99 }, { "color": "green", "value": 99.9 }
          ]}
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "id": 502,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name", "colorMode": "background", "graphMode": "none" },
      "targets": [{ "expr": "avg_over_time(up{job=\"patient-service\"}[24h]) * 100", "legendFormat": "Uptime %", "refId": "A" }],
      "title": "Servicio de Pacientes — Disponibilidad 24h",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Disponibilidad del Servicio de Citas en las últimas 24 horas. Crítico para la operación: si cae, no se pueden reservar citas médicas.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "min": 90, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 99 }, { "color": "green", "value": 99.9 }
          ]}
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "id": 503,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name", "colorMode": "background", "graphMode": "none" },
      "targets": [{ "expr": "avg_over_time(up{job=\"appointment-service\"}[24h]) * 100", "legendFormat": "Uptime %", "refId": "A" }],
      "title": "Servicio de Citas — Disponibilidad 24h",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Disponibilidad del Servicio de Pagos en las últimas 24 horas. Impacto financiero directo: cada minuto caído implica pagos que no se procesan.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "min": 90, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 99 }, { "color": "green", "value": 99.9 }
          ]}
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "id": 504,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name", "colorMode": "background", "graphMode": "none" },
      "targets": [{ "expr": "avg_over_time(up{job=\"payment-service\"}[24h]) * 100", "legendFormat": "Uptime %", "refId": "A" }],
      "title": "Servicio de Pagos — Disponibilidad 24h",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Disponibilidad del Servicio de Horarios en las últimas 24 horas. Necesario para verificar la disponibilidad de médicos al crear una cita.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "min": 90, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 99 }, { "color": "green", "value": 99.9 }
          ]}
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "id": 505,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name", "colorMode": "background", "graphMode": "none" },
      "targets": [{ "expr": "avg_over_time(up{job=\"schedule-service\"}[24h]) * 100", "legendFormat": "Uptime %", "refId": "A" }],
      "title": "Servicio de Horarios — Disponibilidad 24h",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Disponibilidad del Servicio de Notificaciones en las últimas 24 horas. Si cae, los mensajes se acumulan en RabbitMQ y se procesan cuando el servicio se recupera gracias al mecanismo de retry.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "min": 90, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 99 }, { "color": "green", "value": 99.9 }
          ]}
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "id": 506,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name", "colorMode": "background", "graphMode": "none" },
      "targets": [{ "expr": "avg_over_time(up{job=\"notification-service\"}[24h]) * 100", "legendFormat": "Uptime %", "refId": "A" }],
      "title": "Servicio de Notificaciones — Disponibilidad 24h",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 510,
      "title": "Ranking de Disponibilidad — Comparación de SLA entre servicios",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Barras horizontales que muestran el porcentaje de disponibilidad de cada servicio en las últimas 24 horas. El servicio con menor barra es el menos confiable. Verde = cumple SLA 99.9%. Amarillo = cumple SLA 99%. Rojo = por debajo del SLA mínimo.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "min": 90, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 99 }, { "color": "green", "value": 99.9 }
          ]}
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 511,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10
      },
      "targets": [
        { "expr": "avg_over_time(up{job=\"api-gateway\"}[24h]) * 100",          "legendFormat": "API Gateway",               "refId": "A" },
        { "expr": "avg_over_time(up{job=\"patient-service\"}[24h]) * 100",      "legendFormat": "Servicio de Pacientes",     "refId": "B" },
        { "expr": "avg_over_time(up{job=\"appointment-service\"}[24h]) * 100",  "legendFormat": "Servicio de Citas",         "refId": "C" },
        { "expr": "avg_over_time(up{job=\"payment-service\"}[24h]) * 100",      "legendFormat": "Servicio de Pagos",         "refId": "D" },
        { "expr": "avg_over_time(up{job=\"schedule-service\"}[24h]) * 100",     "legendFormat": "Servicio de Horarios",      "refId": "E" },
        { "expr": "avg_over_time(up{job=\"notification-service\"}[24h]) * 100", "legendFormat": "Servicio de Notificaciones","refId": "F" }
      ],
      "title": "Ranking de Disponibilidad (24h) — Comparación SLA por Servicio",
      "type": "bargauge"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Evolución de la disponibilidad de todos los servicios en el tiempo. Una caída a 0 indica que el servicio estuvo completamente caído en ese momento. Permite ver patrones de inestabilidad o reinicios frecuentes.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10, "gradientMode": "opacity", "lineInterpolation": "smooth", "showPoints": "never" },
          "unit": "short",
          "min": 0, "max": 1,
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CAÍDO" }, "1": { "text": "ACTIVO" } } }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 512,
      "options": { "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "up{job=\"api-gateway\"}",          "legendFormat": "API Gateway",               "refId": "A" },
        { "expr": "up{job=\"patient-service\"}",      "legendFormat": "Servicio de Pacientes",     "refId": "B" },
        { "expr": "up{job=\"appointment-service\"}",  "legendFormat": "Servicio de Citas",         "refId": "C" },
        { "expr": "up{job=\"payment-service\"}",      "legendFormat": "Servicio de Pagos",         "refId": "D" },
        { "expr": "up{job=\"schedule-service\"}",     "legendFormat": "Servicio de Horarios",      "refId": "E" },
        { "expr": "up{job=\"notification-service\"}", "legendFormat": "Servicio de Notificaciones","refId": "F" }
      ],
      "title": "Historial de Disponibilidad — Caídas y recuperaciones en el tiempo",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 520,
      "title": "Presupuesto de Errores — ¿Cuántos errores puede tolerar el sistema según el SLA?",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Porcentaje de solicitudes que terminaron exitosamente (HTTP 2xx) en el sistema completo. El SLA de disponibilidad de aplicación estipula que mínimo el 99.5% de solicitudes deben tener éxito. Por debajo de ese umbral se considera incumplimiento.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "min": 95, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 99 }, { "color": "green", "value": 99.5 }
          ]}
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 16 },
      "id": 521,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name", "colorMode": "background", "graphMode": "area" },
      "targets": [{ "expr": "(1 - sum(rate(http_server_requests_seconds_count{status=~\"5..\",job=~\".*-service|api-gateway\"}[15m])) / sum(rate(http_server_requests_seconds_count{job=~\".*-service|api-gateway\"}[15m]))) * 100", "legendFormat": "éxito %", "refId": "A" }],
      "title": "Tasa de Éxito Global — % de solicitudes exitosas (SLA mínimo: 99.5%)",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Número total de errores del servidor (5xx) en los últimos 15 minutos. Este es el presupuesto de errores consumido. Un sistema que respeta el SLA debe tener muy pocos errores, especialmente en producción.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 50 }
          ]}
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 16 },
      "id": 522,
      "options": { "reduceOptions": { "calcs": ["sum"] }, "textMode": "value_and_name", "colorMode": "background", "graphMode": "area" },
      "targets": [{ "expr": "sum(increase(http_server_requests_seconds_count{status=~\"5..\",job=~\".*-service|api-gateway\"}[15m]))", "legendFormat": "errores 5xx", "refId": "A" }],
      "title": "Errores Consumidos del Presupuesto — Total de errores 5xx en 15 min",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Tiempo de respuesta que experimenta el usuario promedio (percentil 50) en el sistema completo. Este es el KPI de experiencia de usuario más representativo. Menos de 100ms es excelente para una API de microservicios.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "ms",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 150 }, { "color": "red", "value": 400 }
          ]}
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 16 },
      "id": 523,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name", "colorMode": "background", "graphMode": "area" },
      "targets": [{ "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{job=~\".*-service|api-gateway\"}[5m])) by (le)) * 1000", "legendFormat": "p50 ms", "refId": "A" }],
      "title": "Latencia del Usuario Promedio (p50) — Experiencia típica en ms",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Evolución de la tasa de éxito del sistema en el tiempo. Una línea estable cerca del 100% indica un sistema confiable. Caídas en esta línea corresponden a incidentes que consumen el presupuesto de errores del SLA.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 12, "gradientMode": "opacity", "lineInterpolation": "smooth", "showPoints": "never" },
          "unit": "percent",
          "min": 90, "max": 100
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Tasa de Éxito Global %" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "id": 524,
      "options": { "legend": { "calcs": ["mean", "min"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "(1 - sum(rate(http_server_requests_seconds_count{status=~\"5..\",job=~\".*-service|api-gateway\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=~\".*-service|api-gateway\"}[5m]))) * 100", "legendFormat": "Tasa de Éxito Global %", "refId": "A" },
        { "expr": "(1 - sum(rate(http_server_requests_seconds_count{status=~\"5..\",job=\"appointment-service\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"appointment-service\"}[5m]))) * 100", "legendFormat": "Servicio de Citas %",    "refId": "B" },
        { "expr": "(1 - sum(rate(http_server_requests_seconds_count{status=~\"5..\",job=\"payment-service\"}[5m]))   / sum(rate(http_server_requests_seconds_count{job=\"payment-service\"}[5m])))   * 100", "legendFormat": "Servicio de Pagos %",    "refId": "C" }
      ],
      "title": "Tasa de Éxito en el Tiempo — Confiabilidad del sistema (SLA objetivo: 99.5%)",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "id": 530,
      "title": "Réplicas y Alta Disponibilidad — Instancias activas por servicio",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Número de instancias activas de cada servicio. MediQueue tiene 2 réplicas de los servicios críticos para alta disponibilidad. Si alguno baja a 1, hay riesgo. Si baja a 0, el servicio está completamente caído.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "min": 0, "max": 3,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 1 }, { "color": "green", "value": 2 }
          ]}
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 30 },
      "id": 531,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true
      },
      "targets": [
        { "expr": "count(up{job=\"api-gateway\"}          == 1) or vector(0)", "legendFormat": "API Gateway",               "refId": "A" },
        { "expr": "count(up{job=\"appointment-service\"}  == 1) or vector(0)", "legendFormat": "Servicio de Citas",         "refId": "B" },
        { "expr": "count(up{job=\"payment-service\"}      == 1) or vector(0)", "legendFormat": "Servicio de Pagos",         "refId": "C" },
        { "expr": "count(up{job=\"patient-service\"}      == 1) or vector(0)", "legendFormat": "Servicio de Pacientes",     "refId": "D" },
        { "expr": "count(up{job=\"schedule-service\"}     == 1) or vector(0)", "legendFormat": "Servicio de Horarios",      "refId": "E" },
        { "expr": "count(up{job=\"notification-service\"} == 1) or vector(0)", "legendFormat": "Servicio de Notificaciones","refId": "F" }
      ],
      "title": "Réplicas Activas por Servicio — Alta Disponibilidad (mínimo 2 por servicio crítico)",
      "type": "bargauge"
    },

    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Evolución en el tiempo de las réplicas activas por servicio. Caídas y recuperaciones en esta gráfica corresponden a reinicios, actualizaciones o fallos del sistema. Permite calcular el tiempo de inactividad real.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "gradientMode": "opacity", "lineInterpolation": "smooth", "showPoints": "never" },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 30 },
      "id": 532,
      "options": { "legend": { "calcs": ["min", "mean"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "count(up{job=\"api-gateway\"}          == 1) or vector(0)", "legendFormat": "API Gateway",               "refId": "A" },
        { "expr": "count(up{job=\"appointment-service\"}  == 1) or vector(0)", "legendFormat": "Servicio de Citas",         "refId": "B" },
        { "expr": "count(up{job=\"payment-service\"}      == 1) or vector(0)", "legendFormat": "Servicio de Pagos",         "refId": "C" },
        { "expr": "count(up{job=\"patient-service\"}      == 1) or vector(0)", "legendFormat": "Servicio de Pacientes",     "refId": "D" },
        { "expr": "count(up{job=\"schedule-service\"}     == 1) or vector(0)", "legendFormat": "Servicio de Horarios",      "refId": "E" },
        { "expr": "count(up{job=\"notification-service\"} == 1) or vector(0)", "legendFormat": "Servicio de Notificaciones","refId": "F" }
      ],
      "title": "Historial de Réplicas — Estabilidad de las instancias en el tiempo",
      "type": "timeseries"
    }

  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["mediqueue", "sla", "disponibilidad"],
  "templating": {
    "list": [
      { "current": {}, "hide": 0, "includeAll": false, "label": "Fuente de datos", "multi": false, "name": "datasource", "options": [], "query": "prometheus", "refresh": 1, "type": "datasource" }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "MediQueue — SLA y Disponibilidad",
  "uid": "mediqueue-sla-v1",
  "version": 1
}
