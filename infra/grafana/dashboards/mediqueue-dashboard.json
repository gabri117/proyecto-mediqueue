{
  "__inputs": [],
  "__elements": {},
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "gauge",
      "name": "Gauge",
      "version": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Vista general del sistema de microservicios MediQueue: tráfico, errores, latencia, colas de mensajería, recursos JVM y disponibilidad de servicios",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "title": "Throughput por servicio (req/s)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\".*-service|api-gateway\"}[1m])) by (job)",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "Requests por segundo por servicio",
      "type": "timeseries",
      "description": "Solicitudes HTTP procesadas por segundo en cada microservicio. Permite ver en tiempo real qué servicio tiene más carga y detectar picos inesperados de tráfico."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\",job=~\".*-service|api-gateway\"}[1m])) by (job) / sum(rate(http_server_requests_seconds_count{job=~\".*-service|api-gateway\"}[1m])) by (job)",
          "legendFormat": "{{job}} error rate",
          "refId": "A"
        }
      ],
      "title": "Tasa de error 5xx por servicio",
      "type": "timeseries",
      "description": "Proporción de solicitudes que terminan en error interno del servidor. Un sistema saludable mantiene esto en 0%. Arriba del 1% requiere atención inmediata."
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 101,
      "title": "Latencia (p50 / p95 / p99)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{job=~\".*-service|api-gateway\"}[1m])) by (le, job))",
          "legendFormat": "p50 {{job}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=~\".*-service|api-gateway\"}[1m])) by (le, job))",
          "legendFormat": "p95 {{job}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=~\".*-service|api-gateway\"}[1m])) by (le, job))",
          "legendFormat": "p99 {{job}}",
          "refId": "C"
        }
      ],
      "title": "Latencia p50/p95/p99 por servicio",
      "type": "timeseries",
      "description": "Distribución completa de tiempos de respuesta. p50 = usuario típico, p95 = usuarios lentos, p99 = casos extremos. La diferencia entre p50 y p99 muestra la variabilidad del sistema."
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 102,
      "title": "RabbitMQ - Colas y mensajes",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "id": 4,
      "targets": [
        {
          "expr": "rabbitmq_queue_messages_ready{vhost=\"/\"}",
          "legendFormat": "{{queue}} - ready",
          "refId": "A"
        }
      ],
      "title": "Mensajes listos en colas",
      "type": "timeseries",
      "description": "Eventos en RabbitMQ que están esperando ser procesados por algún consumidor. Si este número crece sin bajar, el servicio de notificaciones no está procesando a tiempo."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "id": 5,
      "targets": [
        {
          "expr": "rabbitmq_queue_messages_unacked{vhost=\"/\"}",
          "legendFormat": "{{queue}} - unacked",
          "refId": "A"
        }
      ],
      "title": "Mensajes no confirmados (unacked)",
      "type": "timeseries",
      "description": "Mensajes entregados al consumidor pero cuyo procesamiento no fue confirmado aún. Un número alto indica que el procesamiento está tardando más de lo esperado."
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "id": 103,
      "title": "JVM - Memoria y CPU",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "id": 6,
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\",job=~\".*-service|api-gateway\"}",
          "legendFormat": "{{job}} - {{id}}",
          "refId": "A"
        }
      ],
      "title": "Uso de heap JVM por servicio",
      "type": "timeseries",
      "description": "Memoria RAM utilizada por los objetos Java en cada servicio. Un crecimiento constante sin estabilizarse indica una posible fuga de memoria."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "id": 7,
      "targets": [
        {
          "expr": "system_cpu_usage{job=~\".*-service|api-gateway\"}",
          "legendFormat": "{{job}} CPU",
          "refId": "A"
        }
      ],
      "title": "CPU por servicio",
      "type": "timeseries",
      "description": "Porcentaje de procesador consumido por cada microservicio. Valores sostenidos por encima del 80% indican que el servicio necesita más instancias o una optimización de código."
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "id": 104,
      "title": "Réplicas activas (health checks)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 37
      },
      "id": 8,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "count(up{job=\"appointment-service\"} == 1)",
          "legendFormat": "Appointment replicas",
          "refId": "A"
        }
      ],
      "title": "Réplicas appointment-service activas",
      "type": "stat",
      "description": "Número de instancias del Servicio de Citas que están respondiendo correctamente. El sistema tiene 2 réplicas para alta disponibilidad."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 37
      },
      "id": 9,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "count(up{job=\"payment-service\"} == 1)",
          "legendFormat": "Payment replicas",
          "refId": "A"
        }
      ],
      "title": "Réplicas payment-service activas",
      "type": "stat",
      "description": "Número de instancias del Servicio de Pagos que están respondiendo. Dos réplicas garantizan que si una falla, la otra continúa procesando pagos."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 37
      },
      "id": 10,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "count(up{job=\"notification-service\"} == 1)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "notification-service UP",
      "type": "stat",
      "description": "Estado del Servicio de Notificaciones. Si cae, los pacientes no recibirán confirmaciones de citas. Los mensajes se acumularán en RabbitMQ hasta que vuelva."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 37
      },
      "id": 11,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "count(up{job=\"patient-service\"} == 1)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "patient-service UP",
      "type": "stat",
      "description": "Estado del Servicio de Pacientes. Si cae, no se pueden consultar ni registrar pacientes en el sistema."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 16,
        "y": 37
      },
      "id": 12,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "count(up{job=\"schedule-service\"} == 1)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "schedule-service UP",
      "type": "stat",
      "description": "Estado del Servicio de Horarios. Necesario para consultar disponibilidad de médicos al momento de reservar una cita."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 20,
        "y": 37
      },
      "id": 13,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "count(up{job=\"api-gateway\"} == 1)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Réplicas api-gateway activas",
      "type": "stat",
      "description": "Número de instancias del API Gateway (puerta de entrada al sistema) que están activas detrás del balanceador de carga HAProxy."
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "id": 105,
      "title": "Conexiones JDBC (HikariCP)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "id": 14,
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=~\".*-service\"}",
          "legendFormat": "{{job}} active",
          "refId": "A"
        }
      ],
      "title": "Conexiones JDBC activas (HikariCP)",
      "type": "timeseries",
      "description": "Conexiones activas al pool de base de datos PostgreSQL por servicio. Si llega al máximo, las nuevas solicitudes esperan y la latencia se dispara."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "id": 15,
      "targets": [
        {
          "expr": "hikaricp_connections_pending{job=~\".*-service\"}",
          "legendFormat": "{{job}} pending",
          "refId": "A"
        }
      ],
      "title": "Conexiones JDBC en espera (pending)",
      "type": "timeseries",
      "description": "Solicitudes de conexión a la base de datos que están esperando porque el pool está lleno. Cualquier valor mayor a 0 es una señal de que el pool necesita ampliarse."
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "mediqueue",
    "microservices"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "MediQueue — Panel de Control Principal",
  "uid": "mediqueue-main",
  "version": 1
}