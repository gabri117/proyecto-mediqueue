        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=~\"appointment-service|payment-service\"}[2m])) by (le, job))", "legendFormat": "p95 {{job}}", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=~\"appointment-service|payment-service\"}[2m])) by (le, job))", "legendFormat": "p99 {{job}}", "refId": "C" }
