    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Memoria heap de la JVM utilizada en este momento por cada microservicio. El heap es donde viven los objetos Java; si se acerca al máximo, el Garbage Collector se vuelve muy activo y degrada el rendimiento.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300000000 },
              { "color": "red", "value": 450000000 }
            ]
          },
          "unit": "bytes"
