    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Porcentaje de heap JVM utilizado respecto al máximo asignado por servicio. Por encima del 85% el GC se dispara continuamente.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
