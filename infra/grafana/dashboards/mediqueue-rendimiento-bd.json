          "expr": "100 * sum by(instance) (jvm_memory_used_bytes{area=\"heap\", instance=~\"schedule-service.*\"}) / sum by(instance) (jvm_memory_max_bytes{area=\"heap\", instance=~\"schedule-service.*\"})",
          "legendFormat": "schedule",
