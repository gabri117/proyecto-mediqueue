    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Saturación del pool de conexiones por servicio: porcentaje de conexiones activas respecto al máximo configurado. Por encima del 80% hay riesgo de degradación.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 8,
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "text": {}
      },
      "title": "Saturación del Pool de Conexiones (% uso / máximo)",
      "type": "bargauge",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * hikaricp_connections_active{instance=~\"patient-service.*\"} / hikaricp_connections_max{instance=~\"patient-service.*\"}",
          "legendFormat": "patient-service",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * hikaricp_connections_active{instance=~\"appointment-service.*\"} / hikaricp_connections_max{instance=~\"appointment-service.*\"}",
          "legendFormat": "appointment-service",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * hikaricp_connections_active{instance=~\"schedule-service.*\"} / hikaricp_connections_max{instance=~\"schedule-service.*\"}",
          "legendFormat": "schedule-service",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * hikaricp_connections_active{instance=~\"payment-service.*\"} / hikaricp_connections_max{instance=~\"payment-service.*\"}",
          "legendFormat": "payment-service",
          "refId": "D"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Evolución temporal de las conexiones activas, inactivas (idle) y pendientes en el pool HikariCP de cada servicio. Permite detectar patrones de carga y cuellos de botella en la BD.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
