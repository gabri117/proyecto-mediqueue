        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "title": "% Heap Usado por Servicio",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum by(instance) (jvm_memory_used_bytes{area=\"heap\", instance=~\"patient-service.*\"}) / sum by(instance) (jvm_memory_max_bytes{area=\"heap\", instance=~\"patient-service.*\"})",
          "legendFormat": "patient",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum by(instance) (jvm_memory_used_bytes{area=\"heap\", instance=~\"appointment-service.*\"}) / sum by(instance) (jvm_memory_max_bytes{area=\"heap\", instance=~\"appointment-service.*\"})",
          "legendFormat": "appointment",
