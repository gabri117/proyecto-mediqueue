      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 21 },
      "id": 11,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"api-gateway-lb\",status=~\"5..\"}[1m])) or vector(0)",
