    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 28 },
      "id": 13,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"appointment-service\"}[5m])) by (le)) or vector(0)",
          "legendFormat": "appointment p95",
          "refId": "A"
        }
      ],
      "title": "Appointment Service Latency p95",
      "type": "timeseries"
    },
    {
