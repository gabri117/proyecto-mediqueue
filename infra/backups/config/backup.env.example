# Copy to a local, untracked location before use.
# Do not commit real secrets.

MEDIQUEUE_BACKUP_POSTGRES_SERVICE=postgres
MEDIQUEUE_BACKUP_DB_NAME=mediqueue
MEDIQUEUE_BACKUP_DB_USER=mediqueue

# Prefer setting this in your shell or a local secret manager, not in git.
# MEDIQUEUE_BACKUP_DB_PASSWORD=

MEDIQUEUE_BACKUP_ROOT=.\infra\backups
MEDIQUEUE_BACKUP_GOOGLE_DRIVE_PATH=
MEDIQUEUE_BACKUP_CONTAINER_WAL_ARCHIVE_DIR=/var/lib/postgresql/wal-archive

MEDIQUEUE_BASE_RETENTION_DAYS=14
MEDIQUEUE_WAL_RETENTION_DAYS=14
MEDIQUEUE_DUMP_RETENTION_DAYS=30
